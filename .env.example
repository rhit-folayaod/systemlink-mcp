# Copy to .env and fill in. Do not commit .env.
# Leave SYSTEMLINK_MCP_SIMULATE unset (or 0) to talk to a real server.

# SYSTEMLINK_MCP_SIMULATE=1

# Fail instead of silently using the fake if the real server is unreachable.
# SYSTEMLINK_MCP_REQUIRE_REAL=1

# Mutating tools (update_result_properties, execute_notebook) refuse unless this is 1.
# SYSTEMLINK_MCP_ALLOW_WRITE=1

# SystemLink Enterprise / Server. The SDK sends the key as x-ni-api-key.
SYSTEMLINK_SERVER_URI=https://yourserver.yourcompany.com
SYSTEMLINK_API_KEY=

# Optional basic auth for some on-prem SystemLink Server installs (not SLE).
# SYSTEMLINK_USERNAME=
# SYSTEMLINK_PASSWORD=

# Optional workspace id passed into HttpConfiguration.
# SYSTEMLINK_WORKSPACE=

# Optional TLS toggle for HttpConfiguration.verify (default true).
# SYSTEMLINK_VERIFY_TLS=true
